{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "",
  "outputDirectory": "public",
  "cleanUrls": true,
  "functions": {
    "api/check.js": { "maxDuration": 300, "includeFiles": "{src/**,proof/**,cache/rules/**}" },
    "api/state.js": { "maxDuration": 10, "includeFiles": "{proof/**,tests/*.test.js}" },
    "api/demo.js": { "maxDuration": 10, "includeFiles": "{src/detect.js,proof/**}" },
    "api/samples.js": { "maxDuration": 15 },
    "api/agent/check.js": { "maxDuration": 300, "includeFiles": "{src/**,proof/**,cache/rules/**}" },
    "api/agent/price.js": { "maxDuration": 30, "includeFiles": "{src/**,proof/**}" }
  },
  "headers": [
    { "source": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
    ] }
  ]
}
